local tabButtons = {}
local function createTabButton(text, pageName)
    local btn = Instance.new("TextButton")
    btn.Parent = TabContainer
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    btn.BackgroundTransparency = 0.15
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(150, 150, 170)
    btn.TextSize = 14
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    
    btn.MouseButton1Click:Connect(function()
        for _, b in ipairs(tabButtons) do
            TweenService:Create(b, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(20, 20, 28),
                TextColor3 = Color3.fromRGB(150, 150, 170)
            }):Play()
        end
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(0, 150, 255),
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
        for name, page in pairs(pages) do
            page.Visible = (name == pageName)
        end
    end)
    
    table.insert(tabButtons, btn)
    return btn
end

local function isEnemy(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local myTeam = player.Team
    local targetTeam = targetPlayer.Team
    if myTeam and targetTeam then
        return myTeam ~= targetTeam
    end
    return true
end

local function removeESP(p)
    if espList[p] then
        if espList[p].highlight then espList[p].highlight:Destroy() end
        if espList[p].name then espList[p].name:Destroy() end
        espList[p] = nil
    end
end

local function addESP(p)
    if espList[p] or p == player then return end
    if not isEnemy(p) then return end
    
    local c = p.Character
    if not c then return end
    local h = c:FindFirstChild("Head")
    if not h then return end
    
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = 0.3
    hl.OutlineTransparency = 0.1
    hl.Enabled = espActive
    hl.Parent = c
    
    local bg = Instance.new("BillboardGui")
    bg.Size = UDim2.new(0, 200, 0, 25)
    bg.Adornee = h
    bg.Enabled = espActive
    bg.Parent = c
    
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.Text = p.Name
    txt.TextColor3 = Color3.fromRGB(255, 0, 0)
    txt.TextSize = 14
    txt.Font = Enum.Font.GothamBold
    txt.BackgroundTransparency = 1
    txt.Parent = bg
    
    espList[p] = {highlight = hl, name = bg}
end

local function updateESP()
    for _, esp in pairs(espList) do
        local c = esp.highlight.Parent
        if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
            if esp.highlight.Enabled ~= espActive then
                esp.highlight.Enabled = espActive
            end
            if esp.name.Enabled ~= espActive then
                esp.name.Enabled = espActive
            end
        else
            if esp.highlight.Enabled then esp.highlight.Enabled = false end
            if esp.name.Enabled then esp.name.Enabled = false end
        end
    end
end

local function getTarget()
    local best = nil
    local bestDist = math.huge
    local myChar = player.Character
    if not myChar then return nil end
    local myPos = myChar:FindFirstChild("HumanoidRootPart")
    if not myPos then return nil end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and isEnemy(p) then
            local humanoid = p.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local dist = (myPos.Position - head.Position).magnitude
                    if dist < MAX_ESP_DISTANCE and dist < bestDist then
                        best = p
                        bestDist = dist
                    end
                end
            end
        end
    end
    return best
end

local function isAlive(target)
    if not target then return false end
    local c = target.Character
    if not c then return false end
    local h = c:FindFirstChild("Humanoid")
    if not h then return false end
    return h.Health > 0
end

local function shootOnce()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.delay(0.05, function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local lastShootTime = 0
local SHOOT_COOLDOWN = 0.15
local function mainLoop()
    frameCounter = frameCounter + 1
    
    if espActive and frameCounter % 30 == 0 then
        for _, p in ipairs(Players:GetPlayers()) do
            if not espList[p] and p ~= player and p.Character then
                addESP(p)
            end
        end
        for p, _ in pairs(espList) do
            if not p.Parent or not isEnemy(p) then
                removeESP(p)
            end
        end
    end
    
    if frameCounter % UPDATE_ESP_INTERVAL == 0 then
        updateESP()
    end
    
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid and speedActive then
            humanoid.WalkSpeed = speed
        end
    end
    
    if aimbotActive then
        if frameCounter % GET_TARGET_INTERVAL == 0 then
            local newTarget = getTarget()
            if newTarget then
                currentTarget = newTarget
            end
        end
        
        if currentTarget and isAlive(currentTarget) and isEnemy(currentTarget) then
            local charTarget = currentTarget.Character
            if charTarget then
                local head = charTarget:FindFirstChild("Head")
                local torso = charTarget:FindFirstChild("HumanoidRootPart")
                local myChar = player.Character
                if myChar then
                    local myPos = myChar:FindFirstChild("HumanoidRootPart")
                    local targetPart = nil
                    if head and torso and myPos then
                        local dist = (myPos.Position - head.Position).magnitude
                        if dist <= 60 then
                            targetPart = head
                        elseif dist > 60 and dist <= 250 then
                            targetPart = torso
                        end
                    end
                    if targetPart then
                        camera.CFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
                        
                        if autoShoot then
                            local now = tick()
                            if now - lastShootTime >= SHOOT_COOLDOWN then
                                lastShootTime = now
                                shootOnce()
                            end
                        end
                    end
                end
            end
        else
            currentTarget = nil
        end
    end
end

local function onCharacterAdded(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.2)
        if p ~= player and p.Character and espActive then
            addESP(p)
        end
    end)
    if p ~= player and espActive then
        addESP(p)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= player then
        onCharacterAdded(p)
    end
end

Players.PlayerAdded:Connect(onCharacterAdded)
Players.PlayerRemoving:Connect(removeESP)

player:GetPropertyChangedSignal("Team"):Connect(function()
    for p, _ in pairs(espList) do
        removeESP(p)
    end
    if espActive then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                addESP(p)
            end
        end
    end
end)

player.CharacterAdded:Connect(function()
    task.wait(2)
    for p, _ in pairs(espList) do
        removeESP(p)
    end
    if espActive then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                addESP(p)
            end
        end
    end
end)

runService.Heartbeat:Connect(mainLoop)

createTabButton("Cheating", "Cheating")
createTabButton("Speed", "Speed")
createTabButton("Credits", "Credits")

tabButtons[1].BackgroundColor3 = Color3.fromRGB(0, 150, 255)
tabButtons[1].TextColor3 = Color3.fromRGB(255, 255, 255)

createToggle("ESP", false, function(state)
    espActive = state
    if state then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                addESP(p)
            end
        end
        updateESP()
    else
        updateESP()
    end
end)
createToggle("Aimbot", false, function(state) aimbotActive = state end)
createToggle("Auto Shoot", false, function(state) autoShoot = state end)
createToggle("Speed", false, function(state) speedActive = state end)
